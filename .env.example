TELEGRAM_BOT_TOKEN=
GOOGLE_SPREADSHEET_ID=
GOOGLE_SHEET_NAME=Лиды
GOOGLE_DRIVE_FOLDER_ID=
DRIVE_SHARE_WITH_LINK=true

# Вариант 1: путь к JSON-ключу сервисного аккаунта
GOOGLE_SERVICE_ACCOUNT_FILE=./credentials.json

# Вариант 2: весь JSON сервисного аккаунта одной строкой (удобно для Docker/CI)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Telegram ID сотрудников через запятую. Пустое значение запрещает запуск бота.
ALLOWED_TELEGRAM_IDS=123456789,987654321

# Руководители видят лиды всех менеджеров. Остальные — только свои.
ADMIN_TELEGRAM_IDS=123456789

# Часовой пояс для дат, записываемых ботом
TIMEZONE=Europe/Moscow

# Путь к Excel-шаблону КП
QUOTE_TEMPLATE_FILE=./templates/КП_Фокси_Логистика_шаблон.xlsx
